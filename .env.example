# Copie para .env e ajuste. Todas as variaveis tem padrao, nenhuma e obrigatoria.

# --- Nobreak ---
# Porta serial do nobreak no host. Vazio desliga o monitoramento.
NOBREAK_PORT=/dev/ttyACM0
# Intervalo entre leituras de status, em segundos.
MONITOR_INTERVAL_SECONDS=30
# false desativa todo desligamento automatico (bateria, temperatura e status critico).
# O monitoramento e a telemetria continuam.
SHUTDOWN_ENABLED=true
# Leituras seguidas em bateria antes de comecar o desligamento.
SHUTDOWN_STEPS=3
# Segundos entre o comando e o corte da saida do nobreak. Faixa aceita: 1 a 90.
SHUTDOWN_DELAY=60
# Temperatura interna que dispara desligamento imediato, em graus Celsius.
CRITICAL_TEMPERATURE=90

# --- MQTT ---
# false desliga o MQTT por completo. A telemetria vai so para o log.
MQTT_ENABLED=true
MQTT_URL=tcp://mosquitto:1883
MQTT_USER=
MQTT_PASS=
MQTT_STATE_TOPIC=joule/nobreak/status

# --- Home Assistant ---
# false para de registrar as entidades, mas segue publicando o estado no MQTT.
HA_DISCOVERY_ENABLED=true
HA_DISCOVERY_PREFIX=homeassistant
# Identificador do dispositivo e prefixo das entidades (sensor.<id>_in_volt).
HA_DEVICE_ID=nobreak

# --- SSH ---
SSH_TIMEOUT=5000
SSH_SHUTDOWN_COMMAND=sudo -n poweroff
